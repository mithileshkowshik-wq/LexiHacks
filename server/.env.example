# Copy this file to .env and fill in real values. .env is git-ignored.

# --- shared ---
MONGODB_URI=mongodb://127.0.0.1:27017/lexipath
PORT=5000
# Set to "production" to hide internal error details from API responses
# (server/middleware/errorHandler.js). Leave unset for local development.
NODE_ENV=

# --- Auth (server/routes/auth.js) ---

# Signs the session token every login issues and every protected route
# verifies (server/middleware/requireAuth.js). Any long random string works
# locally; generate one with e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# Keep the real value only in the ignored server/.env file - rotating it logs
# every signed-in user out at once.
JWT_SECRET=
JWT_EXPIRES_IN=24h

RESEND_API_KEY=
EMAIL_FROM=LexiPath <onboarding@resend.dev>
CLIENT_URL=http://localhost:5173

# --- Error Classification Engine (server/services/errorClassificationEngine.js) ---

# Leave blank to run in mock mode (default when unset): analysis returns a
# fixed, realistic fixture instead of calling Gemini. Set a real key to
# enable the live integration.
GEMINI_API_KEY=

# Force mock mode on/off explicitly. If unset, mock mode is used whenever
# GEMINI_API_KEY is blank.
USE_MOCK_AI=true

# Use the "-latest" alias: pinned model versions get retired for new API keys.
GEMINI_MODEL_NAME=gemini-flash-latest

# Read by BOTH the classification engine above and the recommendation engine
# below - setting it here applies to both. If left unset, each engine falls
# back to its own default: 90000 (90s) for classification (image analysis
# genuinely takes longer), 30000 (30s) for recommendations.
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2

# Base backoff delay (ms) before a retry; doubles each attempt, and is
# quadrupled again for rate-limit (429) errors specifically.
GEMINI_RETRY_BASE_MS=500

# Confidence score (0-1) below which a detected error is flagged "uncertain"
# for the educator instead of a silent AI guess.
ERROR_CONFIDENCE_THRESHOLD=0.6

# --- Intervention Recommendations (server/services/recommendationEngine.js) ---

# Mock mode is the safe default for local development.
RECOMMENDATION_USE_MOCKS=true

# Required when RECOMMENDATION_USE_MOCKS=false. Falls back to GEMINI_API_KEY
# above if left blank, as below - the fallback is a plain `||`, so blank
# ('') and unset both correctly fall through to GEMINI_API_KEY.
GEMINI_RECOMMENDATION_API_KEY=
# Model precedence for recommendations: GEMINI_MODEL_NAME (above) is checked
# FIRST, so if both that and this are set, GEMINI_MODEL_NAME silently wins.
# Leave GEMINI_MODEL_NAME unset if you want this value to take effect.
GEMINI_RECOMMENDATION_MODEL=gemini-flash-latest
# Generic fallback checked after both of the above, before the hardcoded
# 'gemini-flash-latest' default. Rarely needed - most setups won't set this.
GEMINI_MODEL=

# Private Azure Blob source for wiki retrieval and worksheet PDF streaming.
# Keep the real SAS token only in the ignored server/.env file.
AZURE_STORAGE_ACCOUNT_NAME=replace-with-storage-account
AZURE_STORAGE_CONTAINER_NAME=worksheets
AZURE_STORAGE_SAS_TOKEN=replace-with-a-read-only-container-sas
AZURE_KNOWLEDGE_MANIFEST_PATH=_manifests/gemini-canonical-markdown.jsonl
AZURE_ASSET_MANIFEST_PATH=_manifests/blob-upload-manifest.json
# Optional private override for curated 2-3 page ranges. The committed file
# contains deterministic mock entries only; live IDs must match the active
# Azure asset manifest exactly.
WORKSHEET_SECTIONS_PATH=./data/worksheetSections.json
AZURE_FETCH_TIMEOUT_MS=15000
AZURE_MAX_DOCUMENT_BYTES=1048576
AZURE_MAX_MANIFEST_BYTES=5242880
AZURE_MAX_WORKSHEET_BYTES=20971520
