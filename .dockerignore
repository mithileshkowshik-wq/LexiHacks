# Only these files can enter the build context. No .env, scans, or node_modules.
*
!Dockerfile
!.dockerignore
!client/
!client/package.json
!client/package-lock.json
!client/index.html
!client/vite.config.js
!client/src/
!client/src/**
!client/public/
!client/public/**
!server/
!server/package.json
!server/package-lock.json
!server/server.js
!server/app.js
!server/constants.js
!server/config/
!server/config/**
!server/controllers/
!server/controllers/**
!server/data/
!server/data/**
!server/middleware/
!server/middleware/**
!server/models/
!server/models/**
!server/routes/
!server/routes/**
!server/services/
!server/services/**
!server/utils/
!server/utils/**
!server/scripts/
!server/scripts/**
**/.env*
**/*.local
**/node_modules/**
**/samples/**
**/uploads/**
**/*.log
# Legacy private worksheet override is not a cloud build input.
server/data/worksheetSections.live.json
**/dist/**
