# Copy to .env.local and adjust. All Vite client vars must start with VITE_.
# .env.local is git-ignored.

# Base origin for the API. Optional for local dev: vite.config.js proxies
# every /api/... request to http://localhost:5000, and the client itself
# defaults to '/api' when this is unset (see src/lib/api.js), so the proxy
# handles it either way. Set this explicitly when running against a
# non-default server port, a deployed backend, or anything the dev proxy
# doesn't cover.
VITE_API_URL=

# Default (12000ms) is too short for live (non-mock) recommendation
# generation - it chains two sequential Gemini calls plus Azure retrieval,
# and a genuine successful run was observed taking ~24s (one 503 retry
# included). The generation still completes and saves server-side even
# after the client gives up, so a too-short timeout doesn't lose the
# result, it just shows a false "timed out" error instead of the report
# that's about to be ready on next load. Give it real headroom.
VITE_API_TIMEOUT_MS=60000

# Set to "true" to include endpoint/status details in UI errors and log
# request/response info to the console (see src/lib/api.js). Leave unset
# or "false" for normal use - it's noisy.
VITE_DEBUG_API=false
