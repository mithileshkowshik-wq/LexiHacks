# Copy to evaluation/.env and provide local values. Never commit credentials.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
LEXIPATH_SAMPLE_ROOT=

# --- Benchmark runs (evaluation/scripts/generate-model-predictions.mjs) ---
# Comma-separated models to benchmark. Falls back to GEMINI_MODEL_NAME below,
# then to 'gemini-flash-latest', if left blank.
BENCHMARK_MODELS=
# Comma-separated sample IDs to limit a run to. Leave blank to run all.
BENCHMARK_SAMPLE_IDS=
# Delay (ms) between benchmark requests. Defaults to 1000 if unset.
BENCHMARK_DELAY_MS=1000
# Set to "true" to only retry samples that previously failed.
BENCHMARK_RETRY_FAILED_ONLY=false

# Also read by server/.env.example - shared here as a fallback for
# BENCHMARK_MODELS above when running evaluation scripts standalone.
GEMINI_MODEL_NAME=

# --- Retrieval pilots (run-retrieval-pilot.mjs, run-contextual-retrieval-pilot.mjs,
# export-manual-gemini-pilot.mjs) ---
# Local path to the DAS knowledge vault. Defaults to ~/KnowledgeVault if unset.
KNOWLEDGE_VAULT_PATH=
